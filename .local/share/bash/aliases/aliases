alias tmux='tmux -u'
alias config='git --git-dir="$HOME/.dotfiles" --work-tree=$HOME'
alias download='aria2c -x 4 -c --file-allocation=falloc'
alias nvimi='env features=ide nvim'
alias nvimd='env features=default nvim'
alias nvimm='env features=minimal nvim'
alias emctm='env DOOMPROFILE=minimal emacsclient -t -s minimal'
alias emctd='env DOOMPROFILE=default emacsclient -t -s default'
alias emstm='env DOOMPROFILE=minimal emacs -nw'
alias emstd='env DOOMPROFILE=default emacs -nw'
alias emcgm='env DOOMPROFILE=minimal emacsclient -s minimal -c'
alias emcgd='env DOOMPROFILE=default emacsclient -s default -c'
alias emsgm='env DOOMPROFILE=minimal emacs'
alias emsgd='env DOOMPROFILE=default emacs'
